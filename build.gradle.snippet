// Paste/merge these values into android/app/build.gradle
// (inside the `android { defaultConfig { ... } }` block)
// after running `flutter create .` to generate the full android/ project.

android {
    ...
    defaultConfig {
        applicationId "com.dave.ai.voiceassistant"
        minSdkVersion 21
        targetSdkVersion 34
        compileSdkVersion 34
        versionCode 1
        versionName "1.0.0"
    }
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}
